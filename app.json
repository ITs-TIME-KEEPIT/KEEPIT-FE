{
  "expo": {
    "name": "KEEPIT",
    "slug": "keepit-fe",
    "scheme": "keepit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "옷 상태 사진 촬영을 위해 카메라 접근을 허용해주세요.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-image"
    ]
  }
}
