{
  "expo": {
    "name": "KEEPIT",
    "slug": "keepit-fe",
    "scheme": "keepit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "옷 상태 사진 촬영을 위해 카메라 접근을 허용해주세요.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 선택하기 위해 사진 보관함 접근을 허용해주세요.",
          "cameraPermission": "프로필 사진을 촬영하기 위해 카메라 접근을 허용해주세요.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
